### General rules

# Visual Studio files
*.vcproj.*
[dD]ebug/
[rR]elease/
*.vcxproj.user
*.ncb
*.suo
*.opensdf
*.sdf
*.db
*.opendb
*.dat
ipch/
.idea/
.vs/
.vscode/
.venv/
*.sln
*.pyproj
*.aps
*.code-workspace

# Remains of Git merge conflicts
*.orig

# Eclipse metadata?
*.metadata*

# TeX and related files
*.aux
*.idx
*.log
*.out
*.pdf
*.dvi
*synctex.gz*
*.toc

# Backup files
*~
*.bak

# Vim swap files (we are being conservative, they can have more names)
[._]*.sw[mnop]

# Python bytecode files
*.pyc

# Python - Rope project directory (for Vim's python-mode)
.ropeproject/

# Klocwork (static code analysis tool)
.klocwork

# Python project stuff - duplicate to requirements.txt (our usecase), ...
pyproject.toml
uv.lock


### GITS-specific rules

# General
build/
third_party/*
!third_party/patch
!third_party/dependencies.yaml
venv/

# GITS config
recorder/gits_config.txt

# Written by Scripts/QuickBuild/gits_version.py
/gits_cmake_args.txt
/gits_label.txt

# OpenGL
apis/OpenGL/**/*Auto.cpp
apis/OpenGL/**/*Auto.h
apis/OpenGL/**/*Auto.def
plugins/OpenGL/**/*Auto.cpp
plugins/OpenGL/**/*Auto.h

#DirectX
apis/DirectX/**/*Auto.cpp
apis/DirectX/**/*Auto.h
plugins/DirectX/**/*Auto.cpp
plugins/DirectX/**/*Auto.h

# Vulkan
apis/Vulkan/**/*Auto.h
apis/Vulkan/**/*Auto.cpp
apis/Vulkan/layer/VkLayer_vulkan_GITS_recorder.json
plugins/Vulkan/**/*Auto.cpp
plugins/Vulkan/**/*Auto.h

# Configuration
common/**/*Auto.cpp
common/**/*Auto.h

# Documentation
docs/**/*Auto.md

# ThirdParty system
third_party.meta.yaml

# CCode
ccode/**/*Auto.cpp
ccode/**/*Auto.h
ccode/generated
ccode/Build
CCodeFiles/
